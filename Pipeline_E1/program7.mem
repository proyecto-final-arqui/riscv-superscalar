00000093  //   0: addi x1, x0, 0            (i = 0)
00a00113  //   4: addi x2, x0, 10           (n = 10)
00000193  //   8: addi x3, x0, 0            (suma = 0)
00000293  //  12: addi x5, x0, 0            (direccion = 0)
00208c63  //  16: LOOP: beq x1, x2, END     (sale cuando i == n: no se toma 10 veces, se toma 1)
0012a023  //  20: sw x1, 0(x5)              (mem[4i] = i)
001181b3  //  24: add x3, x3, x1            (suma += i)
00108093  //  28: addi x1, x1, 1            (i++)
00428293  //  32: addi x5, x5, 4            (direccion += 4)
fedff06f  //  36: jal x0, LOOP              (vuelve al bucle: se toma 10 veces)
02302e23  //  40: END: sw x3, 60(x0)        (mem[60] = 45)
03c02303  //  44: lw x6, 60(x0)             (45)
001303b3  //  48: add x7, x6, x1            (55)
